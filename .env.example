# Simple-Agents-Studio 部署配置
# 复制为仓库根目录的 .env 后填写。只有一项必填。
# 本文件只放部署编排参数(密钥/端口/镜像/容器名)。
# 模型配置是 Hermes 自身的配置, 本平台不掺和。
# Simple-Agents-Studio deployment configuration
# Copy this file to a project-root `.env` and fill in the values. Only one entry is required.
# This file only carries deployment orchestration parameters (keys / ports / images / container names).
# Model configuration belongs to Hermes itself; this platform does not interpose on it.

# ===== i18n v1.0 (2026-10-14): deployment language =====
# Language for the console and the deployment scripts' terminal output.
# Allowed values: en (default) | zh-cn. Anything else is a hard fail
# in install.sh (per architecture §3.2 / AC C2). Empty / unset is treated
# as `en`. The value crosses into the container as `MW_LANG` via
# data/mw_data/deploy_lang (install.sh writes; main_entry.sh reads+exports).
# Note: this is NOT exported as the POSIX LANG variable, so it never
# affects gateway / hermes / pixel-agents process locale.
# 部署语言: 控制台界面与部署脚本终端输出语言。
# 允许值: en(默认) | zh-cn。空/未设置 = en。非法值 install.sh 会硬报错(架构 §3.2 / AC C2)。
# 值经 data/mw_data/deploy_lang 写入容器,main_entry.sh 启动时读出 export MW_LANG;
# 不会注入 POSIX LANG,不影响 gateway / hermes / pixel-agents 进程编码。
LANG=en

# [required] gateway authentication key — any long random string.
# Generate one with: openssl rand -hex 32
# Worker containers register with the container-internal address
# `http://hermes_<name>:8642` and must present this key in the
# `Authorization: Bearer <key>` header; losing it forces re-registration
# of all workers.
# [必填] gateway 鉴权密钥, 任意长随机串, 生成: openssl rand -hex 32
# worker 容器以容器内网地址 `http://hermes_<name>:8642` 注册, 鉴权头为
# `Authorization: Bearer <key>`。丢失该 key 需重新注册全部 worker。
API_SERVER_KEY=

# [optional] Hermes image (must be >= v2026.9.24, includes Kanban).
# Default points at the Huawei Cloud (cn-north-4) mirror of nousresearch/hermes-agent.
# 海外网络可改用官方: nousresearch/hermes-agent:v2026.9.24
# [可选] Hermes 镜像 (需 >= v2026.9.24, 含 kanban)
#HERMES_IMAGE=swr.cn-north-4.myhuaweicloud.com/ddn-k8s/docker.io/nousresearch/hermes-agent:v2026.9.24

# GW_PORT removed (issue #109): the gateway publishes no host port —
# it is container-internal :8642 only.
# GW_PORT 已废弃 (issue #109): gateway 无宿主端口映射, 仅容器内 :8642。

# [optional] Web console port (used by the built-in multi-agent workflow UI).
# [可选] Web 控制台端口
#CONSOLE_PORT=8700

# [optional] main container name. Rename it when running multiple
# stacks on the same host to avoid Docker name collisions.
# [可选] main 容器名 (同机多套部署时改名避免冲突)
#MAIN_CONTAINER_NAME=hermes_main

# ===== optional: embed hermes-webui (full WebUI, see https://github.com/nesquena/hermes-webui) =====
# Activation: set HERMES_WEBUI_DIR to a cloned hermes-webui project directory.
# Once enabled, main mounts it at /webui and starts it automatically,
# publishing on HERMES_WEBUI_PORT. Leave commented (disabled) for zero impact.
# 启用方式: 填 HERMES_WEBUI_DIR 指向 clone 好的 hermes-webui 项目目录。
# 启用后 main 容器会挂载它到 /webui 并自动启动, 端口映射 HERMES_WEBUI_PORT。
# 不填(留注释)则完全不启用, 零影响。

# hermes-webui project directory (absolute host path), e.g. /opt/hermes-webui.
# The directory must already exist; install.sh does not clone it for you.
# hermes-webui 项目目录(宿主机绝对路径), 例: /opt/hermes-webui
#HERMES_WEBUI_DIR=/opt/hermes-webui

# hermes-webui port (same inside and outside the container), default 8787.
# hermes-webui 端口(容器内外一致), 默认 8787
#HERMES_WEBUI_PORT=8787

# hermes-webui login password.
# IMPORTANT: change the default `change` before exposing the container on a
# reachable network — anyone who can reach the port can try this password.
# hermes-webui 登录密码
#HERMES_WEBUI_PASSWORD=change

# ===== optional: embed the pixel office (pixel-agents visualization) =====
# Renders each worker's live status as pixel-character animations —
# a coder typing at their desk, a stuck worker raising a hand, idle
# characters wandering around. This platform uses the same optional
# sidecar pattern as hermes-webui: when the switch is off, zero
# processes, zero ports, zero resource usage. See DEPLOY.md §3.2.
# 1 = enable pixel-agents sidecar (127.0.0.1:3199 inside the container,
#                                      no host port is published).
# 0 or empty = disabled (recommended: start with 0 and switch on later).
# 把每个 worker 的实时状态渲染成像素角色动画 — coder 在工位打字,
# 卡在澄清时举手气泡, 空闲角色离座走动。本平台用与 hermes-webui 同构的
# 可选侧栏接入: 开关关时零进程 / 零端口 / 零资源占用。详见 DEPLOY.md §3.2。

# 1 = 启用 pixel-agents sidecar(容器内 127.0.0.1:3199, 不对外暴露端口)
# 0 或留空 = 不启用(推荐先用 0, 等要用了再开)
#PIXEL_OFFICE_ENABLED=0

# Mount directory (absolute host path): MUST be the pixel-agents project
# root AFTER `npm install`, i.e. the directory that contains
# node_modules/pixel-agents/dist/cli.js. Its @fastify/* dependencies live
# in the same node_modules, so the whole directory must be mounted.
# **Do not mount an un-installed source checkout** or a bare node_modules/pixel-agents/
# subfolder — cli.js will fail with `@fastify/cors` not found.
# Setup recipe:
#   mkdir -p ~/pixel_office && cd ~/pixel_office && npm install pixel-agents
#   then set PIXEL_OFFICE_DIR=~/pixel_office
# 挂载目录(宿主机绝对路径): 必须是【已 npm install 的 pixel-agents 项目根】,
# 即包含 node_modules/pixel-agents/dist/cli.js 的目录。依赖(@fastify/*)
# 装在同级 node_modules, 必须整目录一起挂。**不要挂未安装的源码仓库**
# 或裸 node_modules/pixel-agents/ — cli.js 启动会报 @fastify/cors 找不到。
# 准备方法:
#   mkdir -p ~/pixel_office && cd ~/pixel_office && npm install pixel-agents
#   然后 PIXEL_OFFICE_DIR=~/pixel_office
#PIXEL_OFFICE_DIR=/home/<user>/pixel_office

# ===== optional: reaper subagent-wait timeout (issue#13) =====
# Independent wait threshold (minutes) for cards whose TODO.md status is
# `waiting_sub`. While `silence < threshold`, the reaper records a data
# stamp only — no knock, no harvest, no TODO change (P1 fix). After the
# threshold it emits a dedicated "subagent wait exceeded, please resume"
# notification to main (P2 safety net). Setting to `0` disables the new
# behavior: waiting_sub cards fall back to the old stuck-after-30min
# path, with the data stamp and dedicated message suppressed. Note: the
# reaper-side waiting_sub classification still treats the card as
# in-progress (covered by the contract timeout), so the 5min "unknown
# status" teardown backstop does not fire on waiting_sub cards even
# when this knob is 0. The default
# is 60 minutes; only lower it after observing real subagent runtimes on
# your workload, and never below ~15 (false positives dominate below that).
# See DEPLOY.md §3 "subagent waiting timeout (issue#13)" and design
# notes mw/reaper.py::_subagent_wait_min for the full semantics.
# 独立等待阈值(分钟), 适用于状态为 waiting_sub 的卡。
# `silence < threshold` 时 reaper 只盖数据戳 — 不敲门、不改 TODO、不收尸
# (P1 修复); 超过阈值后发专属「子任务等待超阈, 建议 resume」敲门给 main
# (P2 兜底)。设为 `0` 关闭新行为: waiting_sub 卡退回旧 30min stuck 路径,
# 不盖戳、不发专属消息。注意: 即便取 0, reaper 侧 waiting_sub 分类仍判
# 「在干活」(由契约 timeout 兜底), 「TODO 缺失 5min 收尸」不会作用于
# waiting_sub 卡。默认 60 分钟; 仅在观测过真实子任务运行时长后
# 再下调, 勿低于 ~15 分钟(以下区间误报会主导)。详见 DEPLOY.md §3
# "subagent waiting timeout (issue#13)" 与 mw/reaper.py::_subagent_wait_min
# 完整语义。
#MW_REAPER_SUBAGENT_MIN=60
